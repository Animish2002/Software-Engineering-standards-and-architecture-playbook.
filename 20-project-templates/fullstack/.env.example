# ---- Server ----
NODE_ENV=development
PORT=4000
LOG_LEVEL=debug

# ---- Database (local Docker Postgres on 5433; see docs/LOCAL-SETUP.md) ----
DATABASE_URL=postgres://app:app@localhost:5433/app
DB_POOL_MAX=10

# ---- Auth (generate each: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))") ----
JWT_SECRET=
JWT_REFRESH_SECRET=
ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_DAYS=30

# ---- Browser origin allowed to call the API; also used to build links in emails ----
CORS_ORIGIN=http://localhost:5173

# ---- Object storage (Cloudflare R2, dev bucket; production uses separate credentials) ----
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=app-files-dev

# ---- Transactional email (sender domain must be verified with the provider) ----
EMAIL_API_KEY=
EMAIL_FROM=noreply@example.com
EMAIL_FROM_NAME=App

# ---- Bot protection (Cloudflare Turnstile; the test secret always passes) ----
TURNSTILE_SECRET_KEY=1x0000000000000000000000000000000AA
RATE_LIMIT_ENABLED=true
